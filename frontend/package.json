{
  "name": "rag-study-assistant-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "test": "node --test src/markdown.test.mjs",
    "test:session-materials": "node --test src/session-materials.test.mjs",
    "test:build-boundary": "node --test scripts/vue-tsc-readonly.test.cjs",
    "build": "node scripts/vue-tsc-readonly.cjs --noEmit -p tsconfig.json && vite build",
    "preview": "vite preview --host 0.0.0.0"
  },
  "dependencies": {
    "dompurify": "^3.4.11",
    "lucide-vue-next": "^0.577.0",
    "marked": "^18.0.5",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.1",
    "jsdom": "^29.1.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vue-tsc": "^2.1.10"
  }
}
